# Sunucu
PORT=5000
NODE_ENV=development
# Sonda / olmadan tek bir frontend origin adresi
FRONTEND_URL=http://localhost:5173

# Veritabanı ve kimlik doğrulama
MONGODB_URI=mongodb+srv://kullanici:sifre@cluster.example.mongodb.net/studyai
JWT_SECRET=uzun-rastgele-bir-deger

# Gemini (üretim ve embedding aynı API anahtarını kullanır)
GEMINI_API_KEY=google-ai-studio-api-anahtari

# Semantik arama
# Mevcut embedding-001 / 768 kayıtlarını koruyun. Otomatik model fallback yoktur.
GEMINI_EMBEDDING_MODELI=gemini-embedding-001
GEMINI_EMBEDDING_BOYUTU=768
GEMINI_EMBEDDING_BATCH_BOYUTU=20
# Projenizin AI Studio'da görünen gerçek kotalarının altında güvenlik payı bırakın.
GEMINI_EMBEDDING_RPM=60
GEMINI_EMBEDDING_TPM=20000
GEMINI_EMBEDDING_RPD=700
GEMINI_EMBEDDING_MAKS_DENEME=3
SEMANTIK_ARAMA_MIN_SKOR=0.2
SEMANTIK_ARAMA_MAKS_ADAY=2500

# Ders özeti (isteğe bağlı; varsayılanlar çoğu ders için yeterlidir)
# Gemini'ye gönderilecek dengeli seçilmiş toplam kaynak metni üst sınırı.
DERS_OZETI_MAKS_KAYNAK_KARAKTERI=180000
# Büyük kaynaklarda sıralı ara özetleme parçasının yaklaşık boyutu.
DERS_OZETI_BATCH_KARAKTERI=35000
# Boş bırakılırsa genel Gemini modeli kullanılır.
GEMINI_OZET_MODELI=gemini-3.5-flash-lite

# Test sistemi (isteğe bağlı; varsayılanlar çoğu ders için yeterlidir)
# Gemini'ye gönderilecek konu ve materyaller arasında dengeli kaynak üst sınırı.
TEST_MAKS_KAYNAK_KARAKTERI=160000
# Boş bırakılırsa genel Gemini modeli kullanılır.
GEMINI_TEST_MODELI=gemini-3.5-flash-lite
# Primary denemeleri en fazla 3; daha düşük özellik ayarı korunur.
GEMINI_TEST_MAKS_DENEME=3
GEMINI_OZET_MAKS_DENEME=3
# Harita/kart/test/özet/sohbet/embedding için model başına eşzamanlı SDK isteği (1–20).
# Bekleme kuyruğu yoktur. Bu sayı Google kotası veya sunucular arası limit değildir.
GEMINI_ORTAK_MAKS_ESZAMANLI_ISTEK=2
# Boşsa yalnızca NODE_ENV=development ortamında etkinleşir. true her ortamda
# etkinleştirir, false açıkça kapatır. Yalnızca güvenli teknik metadata yazılır.
TEST_TANILAMA_LOGU=

# Yalnızca tek backend instance çalıştırıldığı açıkça biliniyorsa etkinleştirin.
STUDYAI_STARTUP_RECOVERY_MODE=disabled

# Konu haritası: hesabınızdaki güncel model kotalarına göre ayarlayın.
# Bunlar evrensel sağlayıcı limitleri değildir; süreç başına koruyucu varsayılanlardır.
GEMINI_KONU_HARITASI_MODELI=gemini-3.5-flash-lite
GEMINI_HARITA_RPM=12
GEMINI_HARITA_TPM=200000
GEMINI_HARITA_RPD=450
GEMINI_HARITA_MAKS_DENEME=2
GEMINI_HARITA_TIMEOUT_MS=60000
# Uzun Retry-After değerlerinde otomatik beklemek yerine manuel yeniden deneme sunulur.
GEMINI_HARITA_MAKS_BEKLEME_MS=30000
# Boşsa mevcut model varsayılanı korunur.
GEMINI_HARITA_MAKS_CIKTI_TOKEN=

# Çalışma kartları: kart sayısı farklı kaynak kavramlarından belirlenir.
GEMINI_KART_MODELI=gemini-3.5-flash-lite
GEMINI_KART_MAKS_DENEME=3
# Sorgu embedding'i, retry ve fallback dahil işlem başına SDK çağrısı (1–12).
# Devam kullanıcı tarafından başlatılır; GET hiçbir üretim çağrısı başlatmaz.
GEMINI_KART_ISLEM_CAGRI_BUTCESI=4
# Kullanıcı+ders başına 24 saatlik kalıcı sınır (1–200); süreç yeniden başlasa da korunur.
GEMINI_KART_DERS_GUNLUK_CAGRI_BUTCESI=48

# V2+ ortak routing: mevcut *_MODELI ayarları aynen çalışır. Bu ayarlar yeni
# modeli etkinleştirmez; PRIMARY yalnız erişimi doğrulanmış listedeyse uygulanır.
# FALLBACK ayrıca aşağıdaki model profilinde pozitif RPM/TPM/RPD gerektirir.
GEMINI_MODEL_ROUTING_AKTIF=false
GEMINI_DOGRULANMIS_MODELLER=
GEMINI_KONU_HARITASI_PRIMARY_MODELI=
GEMINI_KONU_HARITASI_FALLBACK_MODELI=
GEMINI_KART_PRIMARY_MODELI=
GEMINI_KART_FALLBACK_MODELI=
GEMINI_TEST_PRIMARY_MODELI=
GEMINI_TEST_FALLBACK_MODELI=
GEMINI_OZET_PRIMARY_MODELI=
GEMINI_OZET_FALLBACK_MODELI=
GEMINI_SOHBET_MODELI=gemini-3.5-flash-lite
GEMINI_SOHBET_PRIMARY_MODELI=
GEMINI_SOHBET_FALLBACK_MODELI=
# Boşsa mevcut sohbet modeli kullanılır.
GEMINI_SOHBET_BASLIK_MODELI=
GEMINI_SOHBET_BASLIK_PRIMARY_MODELI=
GEMINI_SOHBET_BASLIK_FALLBACK_MODELI=

# Hesabın sağlayıcı kotası değildir: uygulama içi güvenlik tavanlarıdır.
# Aynı modelin bütün özellikleri ortak defteri kullanır; models/ öneki normalize edilir.
# Sıfır limit modeli kapatır. Eski HARITA/EMBEDDING limitleri yalnız bu tavanı düşürebilir.
GEMINI_MODEL_KOTALARI={"gemini-3.5-flash-lite":{"rpm":10,"tpm":175000,"rpd":400},"gemini-3.1-flash-lite":{"rpm":10,"tpm":175000,"rpd":400},"gemini-embedding-001":{"rpm":60,"tpm":20000,"rpd":700}}
GEMINI_PRIMARY_MAKS_DENEME=3
GEMINI_TOPLAM_MAKS_DENEME=4
GEMINI_ISLEM_TIMEOUT_MS=120000

# Batch boyutu pedagojik hedef değildir; kalan kavramlar checkpoint'ten devam eder.
GEMINI_KART_HYBRID_AKTIF=true
GEMINI_KART_BATCH_KONU=3
GEMINI_KART_BATCH_KART=12
GEMINI_KART_BATCH_GIRDI_TOKEN=6000
GEMINI_KART_BATCH_CIKTI_TOKEN=2400
GEMINI_KART_BATCH_MATERYAL=6
