# Sunucu
PORT=5000
NODE_ENV=development
# Sonda / olmadan tek bir frontend origin adresi
FRONTEND_URL=http://localhost:5173

# Veritabanı ve kimlik doğrulama
MONGODB_URI=mongodb+srv://kullanici:sifre@cluster.example.mongodb.net/studyai
JWT_SECRET=uzun-rastgele-bir-deger

# Hesap e-postaları: gerçek değerleri yalnız .env / dağıtım sırlarında tutun.
# CLIENT_URL frontend kökü olmalı; üretimde HTTPS zorunludur.
CLIENT_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
EMAIL_USER=
# Gmail hesabının uygulama şifresi; normal hesap şifrenizi kullanmayın.
EMAIL_PASS=

# Gemini (üretim ve embedding aynı API anahtarını kullanır)
GEMINI_API_KEY=google-ai-studio-api-anahtari

# Semantik arama
# Metin odaklı ve düşük RPD tüketimi için varsayılan model. Gemini Embedding 2'ye
# geçildiğinde tüm mevcut parçalar yeniden indekslenmelidir.
GEMINI_EMBEDDING_MODELI=gemini-embedding-001
GEMINI_EMBEDDING_BOYUTU=768
GEMINI_EMBEDDING_BATCH_BOYUTU=20
# Projenizin AI Studio'da görünen gerçek kotalarının altında güvenlik payı bırakın.
GEMINI_EMBEDDING_RPM=90
GEMINI_EMBEDDING_TPM=27000
GEMINI_EMBEDDING_RPD=900
GEMINI_EMBEDDING_MAKS_DENEME=3
SEMANTIK_ARAMA_MIN_SKOR=0.2
SEMANTIK_ARAMA_MAKS_ADAY=2500

# Ders özeti (isteğe bağlı; varsayılanlar çoğu ders için yeterlidir)
# Gemini'ye gönderilecek dengeli seçilmiş toplam kaynak metni üst sınırı.
DERS_OZETI_MAKS_KAYNAK_KARAKTERI=180000
# Büyük kaynaklarda sıralı ara özetleme parçasının yaklaşık boyutu.
DERS_OZETI_BATCH_KARAKTERI=35000
# Boş bırakılırsa genel Gemini modeli kullanılır.
GEMINI_OZET_MODELI=gemini-3.5-flash-lite

# Test sistemi (isteğe bağlı; varsayılanlar çoğu ders için yeterlidir)
# Gemini'ye gönderilecek konu ve materyaller arasında dengeli kaynak üst sınırı.
TEST_MAKS_KAYNAK_KARAKTERI=160000
# Boş bırakılırsa genel Gemini modeli kullanılır.
GEMINI_TEST_MODELI=gemini-3.5-flash-lite
# Test/özet SDK çağrısı başına toplam deneme (1–5); sohbet 2, başlık 1 kalır.
GEMINI_TEST_MAKS_DENEME=3
GEMINI_OZET_MAKS_DENEME=3
# Test/özet/sohbet için model başına süreç içi eşzamanlı SDK isteği (1–20).
# Bekleme kuyruğu yoktur. Bu sayı Google kotası veya sunucular arası limit değildir.
GEMINI_ORTAK_MAKS_ESZAMANLI_ISTEK=2
# Boşsa yalnızca NODE_ENV=development ortamında etkinleşir. true her ortamda
# etkinleştirir, false açıkça kapatır. Yalnızca güvenli teknik metadata yazılır.
TEST_TANILAMA_LOGU=

# Yalnızca tek backend instance çalıştırıldığı açıkça biliniyorsa etkinleştirin.
STUDYAI_STARTUP_RECOVERY_MODE=disabled

# Konu haritası: hesabınızdaki güncel model kotalarına göre ayarlayın.
# Bunlar evrensel sağlayıcı limitleri değildir; süreç başına koruyucu varsayılanlardır.
GEMINI_KONU_HARITASI_MODELI=gemini-3.5-flash-lite
GEMINI_HARITA_RPM=12
GEMINI_HARITA_TPM=200000
GEMINI_HARITA_RPD=450
GEMINI_HARITA_MAKS_DENEME=2
GEMINI_HARITA_TIMEOUT_MS=60000
# Uzun Retry-After değerlerinde otomatik beklemek yerine manuel yeniden deneme sunulur.
GEMINI_HARITA_MAKS_BEKLEME_MS=30000
# Boşsa mevcut model varsayılanı korunur.
GEMINI_HARITA_MAKS_CIKTI_TOKEN=
